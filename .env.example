# این فایل فقط «نام» کلیدها را نشان می‌دهد.
# مقدارها را هرگز اینجا ننویسید: در GitHub → Settings → Secrets and variables → Actions ثبت شوند.
# برای اجرای محلی، همین فایل را به .env کپی کنید (که در .gitignore هست).

# --- تلگرام (تأیید ویدئو) ---
TELEGRAM_BOT_TOKEN=
# شناسهٔ چت کانال Empire Autopsy (عددی، مثلاً -1001234567890)
TELEGRAM_CHAT_ID_EMPIRE_AUTOPSY=

# --- تولید محتوا ---
OPENAI_API_KEY=

# --- صدا ---
ELEVENLABS_API_KEY=

# --- انتشار (یوتیوب) ---
# محتوای JSON حساب سرویس / توکن OAuth را به‌صورت یک Secret یک‌خطی ذخیره کنید
YOUTUBE_CREDENTIALS_JSON=
